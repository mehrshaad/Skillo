{
  "name": "skillo",
  "description": "Chrome extension that tailors your Overleaf LaTeX resume to a job posting",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "npm run bridge && wxt",
    "build": "npm run bridge && wxt build",
    "zip": "npm run bridge && wxt zip",
    "build:store": "npm run bridge && wxt build --mode store",
    "zip:store": "npm run bridge && wxt zip --mode store",
    "bridge": "node scripts/build-bridge-installers.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
